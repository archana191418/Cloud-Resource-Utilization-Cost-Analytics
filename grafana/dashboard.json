                      "rawQuery": true,
                      "rawSql": "SELECT\r\n    CASE\r\n        WHEN utilization < 30 THEN '0-30%'\r\n        WHEN utilization < 60 THEN '30-60%'\r\n        WHEN utilization < 80 THEN '60-80%'\r\n        ELSE '80-100%'\r\n    END AS utilization_band,\r\n    AVG(cost) AS avg_cost\r\nFROM cloud_data\r\nGROUP BY utilization_band\r\nORDER BY\r\n    MIN(utilization);",
